{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "elicitation-event.v1",
  "description": "Schema for elicitation events appended to the local weak-supervision ledger.",
  "type": "object",
  "required": [
    "schema_version",
    "event_kind",
    "run_id",
    "privacy_tags",
    "evidence_refs",
    "source",
    "timestamp"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["elicitation-event.v1"]
    },
    "event_kind": {
      "type": "string",
      "enum": [
        "capability_probe",
        "weak_label",
        "judge_verdict",
        "eval_result",
        "counterexample"
      ],
      "description": "Semantic kind of the elicitation event."
    },
    "run_id": {
      "type": "string",
      "description": "Current harness run, session, or loop identifier."
    },
    "task_id": {
      "type": "string",
      "description": "Optional Plans task or external task identifier."
    },
    "rubric_id": {
      "type": "string",
      "description": "Optional rubric used to score the result."
    },
    "reward_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Optional calibrated score in [0, 1]."
    },
    "verdict": {
      "type": "string",
      "enum": ["", "APPROVE", "REQUEST_CHANGES", "STOP", "INFO"],
      "description": "Optional verdict from a judge or reviewer."
    },
    "privacy_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["may_train", "do_not_train", "synthetic_only", "legal_hold"]
      },
      "description": "Data-use tags governing downstream use of this event."
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Files, logs, tests, or artifacts that support this event."
    },
    "source": {
      "type": "string",
      "description": "Hook or component that produced this event."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp in UTC."
    },
    "mcp_server": {
      "type": "string"
    },
    "elicitation_id": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "result_status": {
      "type": "string"
    },
    "breezing_session": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
